generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  DRIVER
  ATTENDANT
  OWNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DELETION_REQUESTED
}

model User {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  phone              String     @unique
  email              String?    @unique
  passwordHash       String     @map("password_hash")
  role               UserRole   @default(DRIVER)
  status             UserStatus @default(PENDING_VERIFICATION)
  phoneVerifiedAt    DateTime?  @map("phone_verified_at") @db.Timestamptz
  totpSecretEnc      String?    @map("totp_secret_enc")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz

  refreshTokens      RefreshToken[]
  otpCodes           OtpCode[]
  ownerProfile       OwnerProfile?
  facilityStaff      FacilityStaff[]
  vehicles           Vehicle[]
  bookings           Booking[]
  auditLogs          AuditLog[]
  idempotencyKeys    IdempotencyKey[]

  @@map("users")
}

model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @map("token_hash")
  familyId     String    @map("family_id") @db.Uuid
  deviceLabel  String?   @map("device_label")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  replacedBy   String?   @map("replaced_by") @db.Uuid
  createdIp    String?   @map("created_ip")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model OtpCode {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  phone       String?
  purpose     String
  codeHash    String    @map("code_hash")
  attempts    Int       @default(0)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id])

  @@map("otp_codes")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model OwnerProfile {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  businessName       String             @map("business_name")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  documents          Json
  reviewedBy         String?            @map("reviewed_by") @db.Uuid
  reviewedAt         DateTime?          @map("reviewed_at") @db.Timestamptz
  rejectionReason    String?            @map("rejection_reason")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("owner_profiles")
}

enum FacilityStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

model Facility {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  address          String
  city             String
  latitude         Float
  longitude        Float
  status           FacilityStatus @default(DRAFT)
  hourlyRatePaisa  BigInt         @map("hourly_rate_paisa")
  openingHours     Json           @map("opening_hours")
  contactPhone     String         @map("contact_phone")
  photos           String[]
  approvedBy       String?        @map("approved_by") @db.Uuid
  approvedAt       DateTime?      @map("approved_at") @db.Timestamptz
  version          Int            @default(1)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  staff         FacilityStaff[]
  zones         Zone[]
  slots         Slot[]
  bookings      Booking[]
  parkingEvents ParkingEvent[]

  @@map("facilities")
}

enum StaffAccessRole {
  OWNER
  ATTENDANT
}

model FacilityStaff {
  facilityId String          @map("facility_id") @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  accessRole StaffAccessRole @map("access_role")

  facility Facility @relation(fields: [facilityId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@id([facilityId, userId])
  @@map("facility_staff")
}

model Zone {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facilityId          String   @map("facility_id") @db.Uuid
  name                String
  code                String
  rateOverridePaisa   BigInt?  @map("rate_override_paisa")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  facility Facility @relation(fields: [facilityId], references: [id])
  slots    Slot[]

  @@map("zones")
}

enum SlotStatus {
  ACTIVE
  MAINTENANCE
  DISABLED
}

enum VehicleType {
  CAR
  BIKE
  VAN
}

model Slot {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facilityId  String     @map("facility_id") @db.Uuid
  zoneId      String     @map("zone_id") @db.Uuid
  slotCode    String     @map("slot_code")
  status      SlotStatus @default(ACTIVE)
  vehicleType VehicleType @default(CAR) @map("vehicle_type")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  facility Facility @relation(fields: [facilityId], references: [id])
  zone     Zone     @relation(fields: [zoneId], references: [id])
  bookings Booking[]

  @@unique([facilityId, slotCode])
  @@map("slots")
}

model Vehicle {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  plateRaw        String   @map("plate_raw")
  plateNormalised String   @map("plate_normalised")
  make            String?
  model           String?
  color           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user     User      @relation(fields: [userId], references: [id])
  bookings Booking[]

  @@map("vehicles")
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  COMPLETED
  EXPIRED
  NO_SHOW
  CANCELLED
}

model Booking {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference                String        @unique
  userId                   String        @map("user_id") @db.Uuid
  facilityId               String        @map("facility_id") @db.Uuid
  slotId                   String        @map("slot_id") @db.Uuid
  vehicleId                String        @map("vehicle_id") @db.Uuid
  plateSnapshot            String        @map("plate_snapshot")
  nameSnapshot             String        @map("name_snapshot")
  phoneSnapshot            String        @map("phone_snapshot")
  startTime                DateTime      @map("start_time") @db.Timestamptz
  endTime                  DateTime      @map("end_time") @db.Timestamptz
  hourlyRatePaisaSnapshot  BigInt        @map("hourly_rate_paisa_snapshot")
  amountPaisa              BigInt        @map("amount_paisa")
  status                   BookingStatus @default(PENDING_PAYMENT)
  holdExpiresAt            DateTime?     @map("hold_expires_at") @db.Timestamptz
  checkedInAt              DateTime?     @map("checked_in_at") @db.Timestamptz
  actualExitAt             DateTime?     @map("actual_exit_at") @db.Timestamptz
  overstayAmountPaisa      BigInt?       @map("overstay_amount_paisa")
  cancelledAt              DateTime?     @map("cancelled_at") @db.Timestamptz
  cancelReason             String?       @map("cancel_reason")
  version                  Int           @default(1)
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  user     User          @relation(fields: [userId], references: [id])
  facility Facility      @relation(fields: [facilityId], references: [id])
  slot     Slot          @relation(fields: [slotId], references: [id])
  vehicle  Vehicle       @relation(fields: [vehicleId], references: [id])
  payments Payment[]
  tickets  Ticket[]
  events   ParkingEvent[]

  @@map("bookings")
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  REFUND_REQUIRED
}

enum PaymentKind {
  BOOKING
  OVERSTAY
}

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId         String        @map("booking_id") @db.Uuid
  kind              PaymentKind   @default(BOOKING)
  amountPaisa       BigInt        @map("amount_paisa")
  currency          String        @default("PKR")
  provider          String
  providerReference String        @map("provider_reference")
  status            PaymentStatus @default(CREATED)
  platformFeePaisa  BigInt        @map("platform_fee_paisa")
  ownerAmountPaisa  BigInt        @map("owner_amount_paisa")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  booking Booking  @relation(fields: [bookingId], references: [id])
  refunds Refund[]

  @@unique([provider, providerReference])
  @@map("payments")
}

model PaymentEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        String
  providerEventId String   @map("provider_event_id")
  payload         Json
  signatureValid  Boolean  @map("signature_valid")
  processedAt     DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@unique([provider, providerEventId])
  @@map("payment_events")
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

model Refund {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId         String       @map("payment_id") @db.Uuid
  amountPaisa       BigInt       @map("amount_paisa")
  status            RefundStatus @default(PENDING)
  reason            String?
  providerReference String?      @map("provider_reference")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

enum TicketStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

model Ticket {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId  String       @map("booking_id") @db.Uuid
  tokenHash  String       @unique @map("token_hash")
  validFrom  DateTime     @map("valid_from") @db.Timestamptz
  validUntil DateTime     @map("valid_until") @db.Timestamptz
  status     TicketStatus @default(ACTIVE)
  usedAt     DateTime?    @map("used_at") @db.Timestamptz
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("tickets")
}

model ParkingEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId  String   @map("booking_id") @db.Uuid
  eventType  String   @map("event_type")
  actorId    String?  @map("actor_id") @db.Uuid
  facilityId String   @map("facility_id") @db.Uuid
  metadata   Json?
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  booking  Booking  @relation(fields: [bookingId], references: [id])
  facility Facility @relation(fields: [facilityId], references: [id])

  @@map("parking_events")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

model IdempotencyKey {
  key          String
  userId       String   @map("user_id") @db.Uuid
  endpoint     String
  requestHash  String   @map("request_hash")
  responseStatus Int    @map("response_status")
  responseBody Json     @map("response_body")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@id([userId, key])
  @@map("idempotency_keys")
}

model Setting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settings")
}
